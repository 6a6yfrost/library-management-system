{
  "info": {
    "name": "Library API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "genreId", "value": "" },
    { "key": "bookId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@lib.com\",\n  \"name\": \"Head Librarian\",\n  \"password\": \"secret123\",\n  \"role\": \"LIBRARIAN\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@lib.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Me (protected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "List Genres",
          "request": { "method": "GET", "url": "{{baseUrl}}/genres" }
        },
        {
          "name": "Get Genre",
          "request": { "method": "GET", "url": "{{baseUrl}}/genres/{{genreId}}" }
        },
        {
          "name": "Create Genre (LIBRARIAN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/genres",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Science Fiction\",\n  \"description\": \"Futuristic tales\"\n}"
            }
          }
        },
        {
          "name": "Update Genre (LIBRARIAN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/genres/{{genreId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\"\n}"
            }
          }
        },
        {
          "name": "Delete Genre (LIBRARIAN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List Books (filter+search+page)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?genreId={{genreId}}&search=dune&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "genreId", "value": "{{genreId}}" },
                { "key": "search", "value": "dune" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Book",
          "request": { "method": "GET", "url": "{{baseUrl}}/books/{{bookId}}" }
        },
        {
          "name": "Create Book (LIBRARIAN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"978-0441172719\",\n  \"totalCopies\": 5,\n  \"genreId\": \"{{genreId}}\"\n}"
            }
          }
        },
        {
          "name": "Update Book (LIBRARIAN)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/books/{{bookId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 8\n}"
            }
          }
        },
        {
          "name": "Delete Book (LIBRARIAN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Profile (protected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/profile"
          }
        }
      ]
    }
  ]
}